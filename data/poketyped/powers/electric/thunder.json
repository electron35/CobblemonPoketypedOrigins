{
    "type": "origins:multiple",
    "charging": {
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_cd",
            "comparison": "==",
            "compare_to": 0
        },
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:or",
                        "conditions": [
                            {
                                "type": "origins:in_rain"
                            },
                            {
                                "type": "origins:in_thunderstorm"
                            }
                        ]
                    },
                    "if_action": {
                        "type": "origins:change_resource",
                        "resource": "*:*_charge",
                        "change": 2,
                        "operation": "add"
                    },
                    "else_action": {
                        "type": "origins:change_resource",
                        "resource": "*:*_charge",
                        "change": 1,
                        "operation": "add"
                    }
                },
                {
                    "type": "origins:trigger_cooldown",
                    "power": "*:*_decaycd"
                }
            ]
        },
        "cooldown": 0,
        "key": {
            "key": "key.origins.primary_active",
            "continuous": true
        }
    },
    "cd": {
        "type": "origins:cooldown",
        "cooldown": 1200,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/resource_bar.png",
            "bar_index": 2
        }
    },
    "charge": {
        "type": "origins:resource",
        "min": 0,
        "max": 100,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/resource_bar.png",
            "bar_index": 5,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_charge",
                "comparison": "!=",
                "compare_to": 0
            }
        },
        "max_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:trigger_cooldown",
                    "power": "*:*_cd"
                },
                {
                    "type": "origins:raycast",
                    "distance": 40,
                    "block": true,
                    "entity": true,
                    "shape_type": "outline",
                    "fluid_handling": "any",
                    "bientity_action": {
                        "type": "origins:target_action",
                        "action": {
                            "type": "origins:spawn_entity",
                            "entity_type": "minecraft:lightning_bolt",
                            "entity_action": {
                                "type": "origins:delay",
                                "action": {
                                    "type": "origins:spawn_entity",
                                    "entity_type": "minecraft:lightning_bolt"
                                },
                                "ticks": 30
                            }
                        }
                    },
                    "block_action": {
                        "type": "origins:spawn_entity",
                        "entity_type": "minecraft:lightning_bolt",
                        "entity_action": {
                            "type": "origins:delay",
                            "action": {
                                "type": "origins:spawn_entity",
                                "entity_type": "minecraft:lightning_bolt"
                            },
                            "ticks": 20
                        }
                    },
                    "miss_action": {
                        "type": "origins:set_resource",
                        "resource": "*:*_cd",
                        "value": 200
                    },
                    "space": "world"
                },
                {
                    "type": "origins:set_resource",
                    "resource": "*:*_charge",
                    "value": 0
                }
            ]
        }
    },
    "decay": {
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:and",
                    "conditions": [
                        {
                            "type": "origins:resource",
                            "resource": "*:*_decaycd",
                            "comparison": "==",
                            "compare_to": 0
                        },
                        {
                            "type": "origins:resource",
                            "resource": "*:*_charge",
                            "comparison": "!=",
                            "compare_to": 0
                        }
                    ]
                }
            ]
        },
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_charge",
            "change": -5,
            "operation": "add"
        }
    },
    "decaycd": {
        "type": "origins:cooldown",
        "cooldown": 20
    }
}