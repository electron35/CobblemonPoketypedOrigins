{
    "name": "Giga Drain",
    "description": "Slow yourself, you then drain the life of all entities affected by your seed, hurting them, slowing them and healing you",
    "type": "origins:multiple",
    "active": {
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_cd",
            "comparison": "==",
            "compare_to": 0
        },
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:area_of_effect",
            "radius": 8,
            "bientity_condition": {
                "type": "origins:target_condition",
                "condition": {
                    "type": "origins:and",
                    "conditions": [
                        {
                            "type": "origins:power",
                            "power": "poketyped:debuff/leechseed"
                        }
                    ]
                }
            },
            "bientity_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:actor_action",
                        "action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:set_resource",
                                    "resource": "*:*_pressed",
                                    "value": 10
                                },
                                {
                                    "type": "origins:spawn_particles",
                                    "particle": "minecraft:composter",
                                    "count": 5,
                                    "speed": 1,
                                    "offset_x": 0,
                                    "offset_y": 0.5,
                                    "offset_z": 0
                                },
                                {
                                    "type": "origins:apply_effect",
                                    "effect": {
                                        "id": "slowness",
                                        "duration": 20,
                                        "amplifier": 2,
                                        "show_particles": true,
                                        "show_icon": true
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "type": "origins:target_action",
                        "action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:change_resource",
                                    "resource": "poketyped:debuff/leechseed_drain",
                                    "change": 1,
                                    "operation": "add"
                                }
                            ]
                        }
                    }
                ]
            }
        },
        "cooldown": 0,
        "key": {
            "key": "key.origins.primary_active",
            "continuous": true
        }
    },
    "cd": {
        "type": "origins:cooldown",
        "cooldown": 900,
        "hud_render": {
            "should_render": true,
            "bar_index": 8,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_cd",
                "comparison": "!=",
                "compare_to": 0
            }
        }
    },
    "maxduration": {
        "type": "origins:resource",
        "min": 0,
        "max": 120,
        "hud_render": {
            "should_render": true,
            "bar_index": 8,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_maxduration",
                "comparison": "!=",
                "compare_to": 0
            }
        },
        "max_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:trigger_cooldown",
                    "power": "*:*_cd"
                },
                {
                    "type": "origins:set_resource",
                    "resource": "*:*_maxduration",
                    "value": 0
                }
            ]
        }
    },
    "pressed": {
        "type": "origins:resource",
        "min": 0,
        "max": 10,
        "start_value": 0,
		"min_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:trigger_cooldown",
                    "power": "*:*_cd"
                },
                {
                    "type": "origins:set_resource",
                    "resource": "*:*_maxduration",
                    "value": 0
                }
            ]
        }
    },
    "decay": {
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_pressed",
            "comparison": ">",
            "compare_to": 0
        },
		"type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_pressed",
                    "change": -1,
                    "operation": "add"
                },
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_maxduration",
                    "change": 1,
                    "operation": "add"
                }
            ]
        }
    }
}